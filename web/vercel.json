{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "react-router",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "regions": [
    "lhr1"
  ],
  "crons": [
    {
      "path": "/api/internal/push-retry",
      "schedule": "0 3 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "fix/heathland-client-scope": false
    }
  }
}
