{
  "expo": {
    "name": "Heathland Links",
    "version": "2.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.heathlandlinks.app",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyASqVSa6Q98DvY5csNodKL0LCp6T6uFflM"
      },
      "infoPlist": {
        "CFBundleDisplayName": "Heathland Links",
        "CFBundleName": "Heathland Links",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Heathland Links uses your location to show nearby golf courses on the map and improve course discovery.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Heathland Links uses your location to show nearby golf courses on the map and improve course discovery.",
        "NSCameraUsageDescription": "Heathland Links uses the camera so you can take photos for your profile and course reviews.",
        "NSPhotoLibraryUsageDescription": "Heathland Links uses your photo library so you can upload profile and course photos.",
        "NSPhotoLibraryAddUsageDescription": "Heathland Links can save photos you choose to share from the app.",
        "NSMicrophoneUsageDescription": "Heathland Links uses the microphone when recording audio or video for course content."
      },
      "associatedDomains": [
        "applinks:anything-all.vercel.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#091811"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyASqVSa6Q98DvY5csNodKL0LCp6T6uFflM"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "package": "com.heathlandlinks.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "anything-all.vercel.app",
              "pathPrefix": "/course/"
            },
            {
              "scheme": "https",
              "host": "anything-all.vercel.app",
              "pathPrefix": "/feed/"
            },
            {
              "scheme": "https",
              "host": "anything-all.vercel.app",
              "pathPrefix": "/lists/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#091811"
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "react-native-maps",
              "react-native-google-maps"
            ]
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#091811"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false,
        "sitemap": false
      },
      "eas": {
        "projectId": "0571c258-6004-4ae8-9604-7463c9403e91"
      }
    },
    "owner": "syedaliwork789s-team",
    "slug": "anything",
    "scheme": "heathlandlinks"
  }
}
